# VCS
.git
.github
.gitignore

# IDE / Claude
.claude
.idea
*.iml
*.swp

# Build artefacts that should NOT end up in the image's build context
repo-chat-bot
repo-chat-bot-*
*.log
build.log

# Local secrets / configs (.env handled at runtime, never copied into image)
.env
.env.*
!.env.example

# Docs / deploy — not needed by `go build`
docs
deploy
README.md

# Test artefacts
*.test
coverage.out

# OS junk
.DS_Store
Thumbs.db
