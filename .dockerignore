# VCS
.git
.github
.gitignore

# IDE / Claude
.claude
.idea
*.iml
*.swp

# Build artefacts that should NOT end up in the image's build context.
# Note: `repo-chat-bot-linux` is the cross-compiled binary Dockerfile.local
# COPYs in — do NOT exclude it with a wildcard.
repo-chat-bot
repo-chat-bot-darwin*
repo-chat-bot-windows*
*.log
build.log

# Local secrets / configs (.env handled at runtime, never copied into image)
.env
.env.*
!.env.example

# Docs / deploy — not needed by `go build`
docs
deploy
README.md

# Test artefacts
*.test
coverage.out

# OS junk
.DS_Store
Thumbs.db
