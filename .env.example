# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Which LLM provider to use. Currently supported: anthropic
# (default if unset). Add more by implementing LLMProvider in a new adapter.
LLM_PROVIDER=anthropic

# API key for the chosen provider.
# Anthropic: https://console.anthropic.com/
LLM_API_KEY=

# Model name. If unset, defaults to a sensible per-provider model
# (anthropic -> claude-sonnet-4-6).
LLM_MODEL=

# Absolute path to the local git repo the bot uses as its knowledge base
REPO_PATH=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Get your ID by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=

# Slack integration (Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_BOT_TOKEN=xoxb-your-bot-token