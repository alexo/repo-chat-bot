# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Which LLM provider to use. Currently supported: anthropic, github, openrouter
# (default if unset: anthropic).
LLM_PROVIDER=anthropic

# API key for the chosen provider.
# Anthropic: https://console.anthropic.com/
# GitHub Models: https://github.com/settings/tokens
# OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=

# Model name. If unset, defaults per provider:
# anthropic -> claude-sonnet-4-6
# github -> gpt-4o
# openrouter -> openai/gpt-4o-mini
LLM_MODEL=

# Optional LLM interaction debug logs (tool calls, rounds, response reasons)
LLM_DEBUG=false

# Absolute path to the local knowledge base directory.
# - Without kbsync (below): required. Point this at the local repo / docs tree.
# - With kbsync enabled: optional — defaults to "<KB_SYNC_BASE_DIR>/current".
REPO_PATH=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Get your ID by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=

# Slack integration (Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Optional short debug mode for Slack event routing diagnostics (true/false)
SLACK_DEBUG=false

# ----------------------------------------------------------------------------
# Knowledge-base sync (object storage → local mirror). Optional.
#
# When KB_STORAGE_PROVIDER is set, the bot will poll the remote bucket on
# KB_SYNC_INTERVAL and mirror its contents into <KB_SYNC_BASE_DIR>/current
# via an atomically-swapped symlink. The remote is treated as the source of
# truth. Leave KB_STORAGE_PROVIDER blank to disable sync entirely.
# ----------------------------------------------------------------------------

# "s3" or "oci". Leave empty to disable sync.
KB_STORAGE_PROVIDER=

# Directory where snapshot folders (kb.<timestamp>/) and the `current` symlink
# live. Required when KB_STORAGE_PROVIDER is set.
KB_SYNC_BASE_DIR=

# Bucket name (S3 or OCI). Required when sync is enabled.
KB_STORAGE_BUCKET=

# Optional prefix inside the bucket. Trailing slash is fine.
KB_STORAGE_PREFIX=

# Bucket region.
KB_STORAGE_REGION=

# S3-only: override endpoint (MinIO, Cloudflare R2, OCI S3-compat, etc.).
KB_STORAGE_ENDPOINT=

# OCI-only.
KB_OCI_NAMESPACE=
# "instance" to use instance principal on an OCI VM, otherwise reads
# ~/.oci/config (override with KB_OCI_CONFIG_FILE / KB_OCI_PROFILE).
KB_OCI_AUTH=
KB_OCI_CONFIG_FILE=
KB_OCI_PROFILE=

# Poll cadence (Go duration: 30s, 15m, 6h). Default 1h.
KB_SYNC_INTERVAL=1h

# Mirror mode: delete local files that no longer exist remotely. Default true.
KB_SYNC_DELETE=true

# Block startup on the first successful sync. Default true.
KB_SYNC_ON_START=true

# AWS credentials for S3 come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, ~/.aws/credentials, IAM role).
