# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Which LLM provider to use. Currently supported: anthropic, github, openrouter
# (default if unset: anthropic).
LLM_PROVIDER=anthropic

# API key for the chosen provider.
# Anthropic: https://console.anthropic.com/
# GitHub Models: https://github.com/settings/tokens
# OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=

# Model name. If unset, defaults per provider:
# anthropic -> claude-sonnet-4-6
# github -> gpt-4o
# openrouter -> openai/gpt-4o-mini
LLM_MODEL=

# Absolute path to the local git repo the bot uses as its knowledge base
REPO_PATH=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Get your ID by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=

# Slack integration (Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Optional short debug mode for Slack event routing diagnostics (true/false)
SLACK_DEBUG=false
