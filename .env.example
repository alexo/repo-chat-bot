# ----------------------------------------------------------------------------
# Chat platforms — enable Telegram, Slack, both, or neither.
# Both toggles default to false. With both disabled the bot still boots
# (useful for KB sync–only deployments or smoke tests); tokens belonging to
# a disabled platform are ignored.
# ----------------------------------------------------------------------------

# Enable Telegram bot. When true, TELEGRAM_BOT_TOKEN and ALLOWED_USER_IDS are required.
TELEGRAM_ENABLED=false

# Telegram bot token from @BotFather. Required when TELEGRAM_ENABLED=true.
TELEGRAM_BOT_TOKEN=

# ----------------------------------------------------------------------------
# AI / LLM. Required when a chat platform is enabled; otherwise optional.
# Defaults to disabled so the binary can boot without any AI credentials
# (e.g. for KB-sync–only deployments or smoke tests).
# ----------------------------------------------------------------------------

# Enable LLM + repo. When true, LLM_API_KEY and REPO_PATH are required.
# Enabling TELEGRAM_ENABLED or SLACK_ENABLED also requires AI_ENABLED=true.
AI_ENABLED=false

# Which LLM provider to use. Currently supported: anthropic, github, openrouter
# (default if unset: anthropic).
LLM_PROVIDER=anthropic

# API key for the chosen provider.
# Anthropic: https://console.anthropic.com/
# GitHub Models: https://github.com/settings/tokens
# OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=

# Model name. If unset, defaults per provider:
# anthropic -> claude-sonnet-4-6
# github -> gpt-4o
# openrouter -> openai/gpt-4o-mini
LLM_MODEL=

# Optional LLM interaction debug logs (tool calls, rounds, response reasons)
LLM_DEBUG=false

# Absolute path to the local knowledge base directory.
# - Without kbsync (below): required. Point this at the local repo / docs tree.
# - With kbsync enabled: optional — defaults to "<KB_SYNC_BASE_DIR>/current".
REPO_PATH=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Required only when TELEGRAM_ENABLED=true. Slack auth is handled by Slack.
# Get your ID by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=

# Enable Slack integration (Socket Mode). When true, both Slack tokens are required.
SLACK_ENABLED=false

# Slack tokens. Required when SLACK_ENABLED=true.
# App token format: xapp-... | Bot token format: xoxb-...
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Optional short debug mode for Slack event routing diagnostics (true/false)
SLACK_DEBUG=false

# ----------------------------------------------------------------------------
# Knowledge-base sync (object storage → local mirror). Optional.
#
# When KBSYNC_ENABLED=true, the bot polls the remote bucket on KB_SYNC_INTERVAL
# and mirrors its contents into <KB_SYNC_BASE_DIR>/current via an atomically
# swapped symlink. The remote is treated as the source of truth. Toggle off and
# the KB_* values are ignored silently.
# ----------------------------------------------------------------------------

# Enable knowledge-base sync. When true, KB_STORAGE_PROVIDER and
# KB_SYNC_BASE_DIR become required.
KBSYNC_ENABLED=false

# "s3" or "oci". Required when KBSYNC_ENABLED=true.
KB_STORAGE_PROVIDER=

# Directory where snapshot folders (kb.<timestamp>/) and the `current` symlink
# live. Required when KBSYNC_ENABLED=true.
KB_SYNC_BASE_DIR=

# Bucket name (S3 or OCI). Required when sync is enabled.
KB_STORAGE_BUCKET=

# Optional prefix inside the bucket. Trailing slash is fine.
KB_STORAGE_PREFIX=

# Bucket region.
KB_STORAGE_REGION=

# S3-only: override endpoint (MinIO, Cloudflare R2, OCI S3-compat, etc.).
KB_STORAGE_ENDPOINT=

# OCI-only.
KB_OCI_NAMESPACE=
# "instance" to use instance principal on an OCI VM, otherwise reads
# ~/.oci/config (override with KB_OCI_CONFIG_FILE / KB_OCI_PROFILE).
KB_OCI_AUTH=
KB_OCI_CONFIG_FILE=
KB_OCI_PROFILE=

# Poll cadence (Go duration: 30s, 15m, 6h). Default 1h.
KB_SYNC_INTERVAL=1h

# Mirror mode: delete local files that no longer exist remotely. Default true.
KB_SYNC_DELETE=true

# Block startup on the first successful sync. Default true.
KB_SYNC_ON_START=true

# AWS credentials for S3 come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, ~/.aws/credentials, IAM role).

# ----------------------------------------------------------------------------
# Healthcheck HTTP endpoint. Optional. When enabled, exposes /healthz on
# HEALTHCHECK_PORT bound to all interfaces (0.0.0.0). Useful for Docker
# HEALTHCHECK, Fly checks, Oracle Cloud LB probes, and Kubernetes liveness.
# Returns 200 OK with body "ok" once the process is up.
# ----------------------------------------------------------------------------

HEALTHCHECK_ENABLED=false
HEALTHCHECK_PORT=8080
